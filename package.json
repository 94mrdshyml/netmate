{
  "name": "netmate",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Open-source, self-hostable, invite-only microblog that runs on Cloudflare.",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:email": "vitest run --project email",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "bun scripts/seed.ts",
    "db:check": "drizzle-kit check",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@dicebear/core": "9.4.3",
    "@dicebear/glass": "9.4.2",
    "@dicebear/identicon": "9.4.2",
    "@dicebear/initials": "9.4.2",
    "@dicebear/notionists-neutral": "9.4.2",
    "@dicebear/pixel-art-neutral": "9.4.2",
    "@dicebear/rings": "9.4.2",
    "@dicebear/shapes": "9.4.2",
    "@dicebear/thumbs": "9.4.2",
    "@opennextjs/cloudflare": "1.20.13",
    "@react-email/components": "1.0.12",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "glob": "10.5.0",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/94mrdshyml/netmate.git"
  },
  "bugs": {
    "url": "https://github.com/94mrdshyml/netmate/issues"
  },
  "homepage": "https://github.com/94mrdshyml/netmate#readme"
}
