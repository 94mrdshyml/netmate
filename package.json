{
  "name": "netmate",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Open-source, self-hostable, invite-only microblog that runs on Cloudflare.",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "glob": "10.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/94mrdshyml/netmate.git"
  },
  "bugs": {
    "url": "https://github.com/94mrdshyml/netmate/issues"
  },
  "homepage": "https://github.com/94mrdshyml/netmate#readme"
}
