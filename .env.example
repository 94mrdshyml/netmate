# Copy to .env (gitignored) and fill in. Never commit .env.
#
# Cloudflare credentials for Wrangler on your machine, and for the GitHub
# Actions secrets used by the deploy job.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# Long-lived API token. Create at https://dash.cloudflare.com/profile/api-tokens
# with these account permissions only:
#   Workers Scripts: Edit
#   D1: Edit
#   Workers R2 Storage: Edit
#   Account Settings: Read
CLOUDFLARE_API_TOKEN=your-api-token

# App secrets (used from phase 2). For local dev put these in .dev.vars instead.
# SETUP_TOKEN=
# AUTH_SECRET=
# SETTINGS_ENCRYPTION_KEY=
